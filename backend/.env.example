APP_NAME="The Clear Move"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Empty/unset = trust no proxies (correct for local/testing, where no
# reverse proxy exists). In production, once a real reverse proxy/load
# balancer is provisioned, set this to its IP(s)/CIDR range(s), comma-
# separated — or to the literal value "*" to trust whichever machine is
# directly connecting (the standard choice for a single-hop proxy whose own
# IP isn't fixed, e.g. Forge/most managed load balancers). Left unset in
# production, HTTPS detection, HSTS, client IP resolution, and IP-keyed rate
# limiting will all use the proxy's IP/scheme instead of the real client's.
# See docs/deployment/Production-Topology.md and
# docs/plans/Critical-Production-Blockers.md, Blocker 7.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Retention window (days) once LOG_STACK is switched to "daily" in
# production — see docs/ops/Customer-1-Launch-Runbook.md, Phase 2.
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=atlas
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Left unset (falls back to Laravel's own scheme auto-detection) — correct
# for local dev over plain http://localhost, where a forced "secure" cookie
# would silently stop the session cookie from being sent at all. In
# production, set this to true explicitly rather than relying on
# auto-detection, especially since that detection depends on TRUSTED_PROXIES
# (above) being configured correctly for whatever proxy is in front of the
# app. See docs/reviews/Production-Deployment-Audit.md (Security section)
# and docs/ops/Customer-1-Launch-Runbook.md, Phase 2.
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# database: jobs run via a queue worker — start one with `composer dev` or:
#   php artisan queue:work --queue=high,ai,default,observations,publishing,analytics,maintenance
# redis: production mode — same worker requirement, backed by Redis. If ever
#   switched to redis, note REDIS_QUEUE_CONNECTION (below) defaults to the
#   same Redis connection SESSION_DRIVER=redis uses — a deliberate choice to
#   revisit at that point, not an oversight.
# sync: runs jobs inline in the HTTP request. Do NOT use for onboarding —
#   the crawl + AI pipeline blocks the request for minutes and causes 502s.
QUEUE_CONNECTION=database
# How long (seconds) a "database" queue job is considered abandoned and
# eligible for retry — only relevant while QUEUE_CONNECTION=database above.
DB_QUEUE_RETRY_AFTER=90

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Keeps the cache store on its own logical Redis database, isolated from
# the session/default connection (REDIS_DB, unset here — defaults to 0).
# Do not remove without also reconsidering REDIS_DB.
REDIS_CACHE_DB=1

# Safe local/test default — never delivers real email. In production, set
# MAIL_MAILER=postmark and the two POSTMARK_* variables below; a boot-time
# guard (App\Services\Mail\ProductionMailerGuard) refuses to send password
# reset email if production is left on log/array. See
# docs/plans/Critical-Production-Blockers.md, Blocker 6.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="atlas@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Postmark — required only when MAIL_MAILER=postmark.
POSTMARK_API_KEY=
POSTMARK_MESSAGE_STREAM_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI Provider
# local: deterministic development stub; never allowed outside APP_ENV=local.
# anthropic: hosted provider for staging/production; requires ANTHROPIC_API_KEY.
# fake: PHPUnit only. ollama: private localhost provider implemented by SCRUM-82.
AI_PROVIDER=local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# OllamaAiProvider rejects non-loopback URLs so the daemon cannot be exposed
# through Atlas configuration. OLLAMA_THINK applies only to plain prompts;
# schema-bound prompts always force thinking off and temperature zero.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_THINK=false

# Visual asset generation (SCRUM-71) — OFF by default. Only the `fake`
# provider exists until a real hosted image API is selected; nothing calls
# it unless IMAGE_GENERATION_ENABLED=true. Generated images land on the
# IMAGE_GENERATION_DISK filesystem under generated-content/.
IMAGE_GENERATION_ENABLED=false
IMAGE_GENERATION_PROVIDER=fake
IMAGE_GENERATION_DISK=public
IMAGE_GENERATION_DAILY_LIMIT=20
# Grace period (days) before the weekly PruneGeneratedImages job removes a
# stored generated image that no live content asset still references.
IMAGE_GENERATION_RETENTION_DAYS=30

# Meta Graph API (Instagram/Facebook publishing OAuth) — no Meta App
# registered yet; these are unusable stubs until real values are set.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# Error tracking — keep the null driver outside production. Sentry deliberately
# excludes default PII/request bodies; tracing defaults to a conservative 5%.
ERROR_TRACKING_DRIVER=null
ERROR_TRACKING_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_RELEASE=
